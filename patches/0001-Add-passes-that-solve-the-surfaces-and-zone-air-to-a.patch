+
 // ObjexxFCL Headers
 #include <ObjexxFCL/Array1D.hh>
 
@@ -81,6 +84,9 @@ namespace HVACManager {
     // Functions
     void ManageHVAC(EnergyPlusData &state);
 
+    // Solve the surface and zone air heat balances to agreement within the zone timestep
+    void IterateSurfaceAirCoupling(EnergyPlusData &state, Real64 &ZoneTempChange, Real64 const PriorTimeStep);
+
     void SimHVAC(EnergyPlusData &state);
 
     void SimSelectedEquipment(EnergyPlusData &state,
@@ -154,6 +160,19 @@ struct HVACManagerData : BaseGlobalStruct
     int MaxErrCount = 0;
     std::string ErrEnvironmentName;
 
+    // Surface-air passes (see IterateSurfaceAirCoupling)
+    bool surfAirIterInit = false;
+    int surfAirMaxIter = 0;     // maximum extra passes per zone timestep; 0 = off, as the release
+    Real64 surfAirTol = 1.0e-9; // [C] convergence tolerance on zone air temperature between passes
+    std::vector<Real64> zoneMATStart;      // zone MAT at the start of the zone timestep
+    std::vector<Real64> zoneHumRatStart;   // zone humidity ratio at the start of the zone timestep
+    std::vector<Real64> spaceMATStart;     // space MAT at the start of the zone timestep
+    std::vector<Real64> spaceHumRatStart;  // space humidity ratio at the start of the zone timestep
+    long surfAirSteps = 0;                 // zone timesteps iterated (this environment, after warmup)
+    long surfAirPasses = 0;                // extra passes (this environment, after warmup)
+    long surfAirNotConverged = 0;          // timesteps that hit the pass limit
+    int surfAirMaxPassesUsed = 0;          // largest number of passes in one timestep
+
     void init_constant_state([[maybe_unused]] EnergyPlusData &state) override
     {
     }
